{
	"$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!dist",
			"!**/coverage",
			"!docs/architecture",
			"!src/engine/__fixtures__/keyring_vectors.json",
			"!src/seal/__fixtures__/legacy",
			"!src/vector/sqlite/assets/sqlite3.mjs",
			"!src/vector/sqlite/assets/sqlite3-opfs-async-proxy.js",
			"!src/vector/sqlite/assets/opfsAsyncProxySource.ts",
			"!src/vector/sqlite/assets/sqlite3.wasm",
			"!test-results"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"noExplicitAny": "error"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
