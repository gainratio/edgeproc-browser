{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"outDir": "dist",
		"rootDir": "src",
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		/* Browser entries are node-free. The explicit Node-only sqlite entry
		   scopes its own node type reference, so it cannot leak into them. */
		"types": []
	},
	"include": ["src"],
	"exclude": [
		"src/**/*.test.ts",
		"src/engine/fixtures.ts",
		"src/engine/__fixtures__/**",
		"src/**/__fixtures__/**",
		"test"
	]
}
