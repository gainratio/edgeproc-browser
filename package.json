{
	"name": "@gainratio/browser",
	"version": "0.2.1",
	"type": "module",
	"description": "For web developers: have the browser check that downloaded data was signed by you and not changed, then keep it for offline use.",
	"keywords": [
		"local-first",
		"offline-first",
		"opfs",
		"web-worker",
		"ed25519",
		"content-addressed",
		"zstd",
		"integrity",
		"signed-bundle",
		"browser",
		"typescript"
	],
	"license": "MIT",
	"author": "Harish Seshadri",
	"homepage": "https://github.com/hseshadr/edgeproc-browser#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hseshadr/edgeproc-browser.git"
	},
	"bugs": {
		"url": "https://github.com/hseshadr/edgeproc-browser/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"packageManager": "pnpm@11.5.0",
	"engines": {
		"node": ">=22.13"
	},
	"files": [
		"dist"
	],
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./worker": {
			"types": "./dist/engine/worker.d.ts",
			"import": "./dist/engine/worker.js"
		},
		"./spawn": {
			"types": "./dist/engine/spawn.d.ts",
			"import": "./dist/engine/spawn.js"
		},
		"./vector": {
			"types": "./dist/vector/index.d.ts",
			"import": "./dist/vector/index.js"
		},
		"./vector/sqlite": {
			"types": "./dist/vector/sqlite/index.d.ts",
			"import": "./dist/vector/sqlite/index.js"
		},
		"./vector/sqlite/node": {
			"types": "./dist/vector/sqlite/node.d.ts",
			"import": "./dist/vector/sqlite/node.js"
		},
		"./sqlite": {
			"types": "./dist/sqlite/index.d.ts",
			"import": "./dist/sqlite/index.js"
		},
		"./sql": {
			"types": "./dist/sql/index.d.ts",
			"import": "./dist/sql/index.js"
		},
		"./package.json": "./package.json"
	},
	"sideEffects": [
		"./dist/engine/worker.js",
		"./dist/vector/sqlite/worker.js",
		"./dist/sqlite/worker.js",
		"./dist/sql/worker.js"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json && node scripts/copy-vector-assets.mjs",
		"prepare": "npm run build",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "vitest run --coverage",
		"test:browser": "tsc -p tsconfig.build.json && node scripts/copy-vector-assets.mjs && playwright test",
		"test:watch": "vitest",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"verify:dist": "node scripts/verify-dist.mjs",
		"demo": "npm run build && node examples/quickstart.mjs",
		"gate": "npm run lint && npm run typecheck && npm run build && npm run verify:dist && npm run test",
		"preflight": "node scripts/preflight-publish.mjs",
		"prepublishOnly": "npm run preflight && npm run gate"
	},
	"dependencies": {
		"@hpcc-js/wasm-zstd": "^1.16.1",
		"@noble/ed25519": "^3.2.0",
		"idb-keyval": "^6.3.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@playwright/test": "^1.63.0",
		"@types/node": "^26.6.3",
		"@vitest/coverage-v8": "^5.0.2",
		"fake-indexeddb": "^6.2.5",
		"jsdom": "^30.1.1",
		"typescript": "~7.0.2",
		"vite": "^8.3.1",
		"vitest": "^5.0.2"
	}
}
